{
  "name": "toeic-app-vorb",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "report:inventory": "node scripts/generate-courseware-inventory.js",
    "test:scoring": "node scripts/test-scoring.js",
    "test:audit": "node scripts/test-audit-quality.js",
    "test:patch": "node scripts/test-questionbank-patch.js",
    "test:mup": "node scripts/verify-minimum-usable-packs.js",
    "test:export-governance": "node scripts/verify-export-review-governance.js",
    "test:data": "node scripts/validate-vocab-data.js",
    "test:docs": "node scripts/check-doc-consistency.js",
    "test:pages-mobile": "playwright test tests/pages-subpath-routing.spec.ts",
    "test:pages-live": "node scripts/verify-pages-live-release.js",
    "test:all": "node scripts/test-scoring.js && node scripts/validate-vocab-data.js && node scripts/check-doc-consistency.js && node scripts/test-audit-quality.js && node scripts/test-questionbank-patch.js && node scripts/verify-minimum-usable-packs.js && node scripts/verify-export-review-governance.js && playwright test",
